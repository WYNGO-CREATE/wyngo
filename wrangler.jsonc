{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Le nom du worker qui sert réellement le CRM. Il s'appelait
  // "tanstack-start-app" (nom du gabarit de départ), ce qui envoyait tout
  // `wrangler deploy` sans argument sur un worker inutilisé.
  "name": "wyngoworkspace",

  // Les adresses du CRM et de l'espace client. Un client qui reçoit un lien
  // vers « wyngoworkspace.bold-unit-739e.workers.dev » ne peut pas prendre
  // l'agence au sérieux — et ce nom ne veut plus rien dire depuis Group Arsène.
  // Les deux pointent sur le même worker ; c'est le chemin qui distingue.
  // Déclarer des routes DÉSACTIVE l'adresse workers.dev par défaut. Le site
  // entier est tombé pendant quelques minutes (erreur 1042) parce que les
  // certificats des nouveaux domaines n'étaient pas encore émis. On garde
  // l'adresse workers.dev comme filet.
  "workers_dev": true,
  "routes": [
    { "pattern": "espaceclient.grouparsene.fr", "custom_domain": true },
    { "pattern": "app.grouparsene.fr", "custom_domain": true }
  ],
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
}
